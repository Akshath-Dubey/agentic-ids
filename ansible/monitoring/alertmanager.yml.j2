# Managed by Ansible. Email is enabled only when an SMTP password is provided.
global:
  resolve_timeout: 5m
{% if smtp_password | length > 0 %}
  smtp_smarthost: "{{ smtp_host }}"
  smtp_from: "Agentic IDS Alerts <{{ alert_email }}>"
  smtp_auth_username: "{{ smtp_username | default(alert_email, true) }}"
  smtp_auth_password: "{{ smtp_password }}"
  smtp_require_tls: true
{% endif %}

route:
  receiver: {{ 'email' if smtp_password | length > 0 else 'none' }}
  group_by: [alertname, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: none
{% if smtp_password | length > 0 %}
  - name: email
    email_configs:
      - to: "{{ alert_email }}"
        send_resolved: true
{% endif %}
